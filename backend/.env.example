# Backend Environment Variables (.env)
# -----------------------------------

# Server Port
PORT=5001

# MongoDB Atlas Connection String
# Get this from your MongoDB Atlas dashboard (Security -> Database Access -> Connect -> Drivers)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/automation_dashboard?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/automation_dashboard

# Allowed CORS Origins (Frontend URL)
# Use '*' for development, or your Vercel URL for production
CORS_ORIGIN=http://localhost:3000

# Node Environment
NODE_ENV=development
